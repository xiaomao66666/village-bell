<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="村庄铃铛" android:textColor="#53764E" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:id="@+id/widget_sync" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingHorizontal="10dp" android:text="＋ 同步" android:textColor="#53764E" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_icon" android:layout_width="58dp" android:layout_height="58dp" android:scaleType="fitCenter" android:contentDescription="升级项目"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="10dp">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#303B30" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A76B25" android:textSize="12sp" android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#6F7564" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
